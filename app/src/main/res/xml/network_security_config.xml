<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <!-- All HTTPS origins trusted via system certs by default; this domain list is informational only.
         Kept explicit so it is obvious which external endpoints the app talks to. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">binance.com</domain>
        <domain includeSubdomains="true">binancefuture.com</domain>
        <domain includeSubdomains="true">unpkg.com</domain>
        <domain includeSubdomains="true">jsdelivr.net</domain>
        <domain includeSubdomains="true">appassets.androidplatform.net</domain>
    </domain-config>
</network-security-config>
